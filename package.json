{
  "name": "linkpulse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node --env-file-if-exists=.env server/src/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/src/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "node --watch --env-file-if-exists=.env server/src/index.js",
    "seed": "node --env-file-if-exists=.env server/src/seed.js",
    "clear": "node --env-file-if-exists=.env server/scripts/clear.js",
    "test": "npm --prefix server test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "geoip-lite": "^1.4.1",
    "helmet": "^8.1.0",
    "isbot": "^5.1.26",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.5",
    "pg": "^8.14.1",
    "qrcode": "^1.5.4",
    "ua-parser-js": "^1.0.40",
    "zod": "^3.24.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
