# ---- LinkPulse frontend environment ----
# The deployed backend (API + redirect host). Leave empty in dev to use the
# Vite proxy (/api -> http://localhost:3001).
VITE_API_BASE=

# Optional: separate domain that serves short links (defaults to VITE_API_BASE).
# VITE_SHORT_BASE=https://lp.linkpulse.dev
VITE_SHORT_BASE=

# Google OAuth 2.0 Client ID (from Google Cloud Console)
# Required to show the real Google account chooser popup with device accounts.
# VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
