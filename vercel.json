{
  "version": 2,
  "buildCommand": "npm --prefix client install && npm --prefix client run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/src/db/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/bio/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(app|login|register|dashboard|links|create|campaigns|tags|folders|settings|admin|import)(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/:code([a-zA-Z0-9_-]{4,10})",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
