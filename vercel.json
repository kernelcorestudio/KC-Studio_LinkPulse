{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "server",
          "format": "url",
          "env": "SERVER_URL"
        }
      ]
    },
    "server": {
      "root": "server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/bio",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/bio/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(app|login|register|dashboard|links|create|campaigns|tags|folders|settings|admin|import)(.*)",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/:code",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
