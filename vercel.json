{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/src/db/*.sql"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/bio", "destination": "/index.html" },
    { "source": "/bio/(.*)", "destination": "/api/index.js" },
    { "source": "/(app|login|register|dashboard|links|create|campaigns|tags|folders|settings|admin|import)(.*)", "destination": "/index.html" },
    { "source": "/:code", "destination": "/api/index.js" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }
      ]
    }
  ]
}
