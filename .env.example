# ==============================================================================
# LinkPulse - Unified Environment Configuration Template
# Copy this file to .env and fill in your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server Configuration
# ------------------------------------------------------------------------------
PORT=3001
# Public base URL that serves short links (the redirect host)
BASE_URL=http://localhost:3001
# Comma-separated allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. Security Secrets (Change in Production)
# ------------------------------------------------------------------------------
JWT_SECRET=dev-change-me-please-use-a-long-random-string
IP_HASH_SALT=dev-change-me-ip-salt

# ------------------------------------------------------------------------------
# 3. Database Configuration
# Leave empty to use built-in SQLite fallback (local dev),
# or provide PostgreSQL URL (e.g., Supabase / Neon):
# ------------------------------------------------------------------------------
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cookie security (set true when serving over https)
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 4. Frontend Client Configuration (Vite)
# NOTE: Only variables prefixed with VITE_ are exposed to the client browser.
# ------------------------------------------------------------------------------
# Deployed backend URL (leave empty in local dev to use Vite proxy -> localhost:3001)
VITE_API_BASE=
# Public domain that serves short links (defaults to VITE_API_BASE if empty)
VITE_SHORT_BASE=
# Google OAuth 2.0 Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=
