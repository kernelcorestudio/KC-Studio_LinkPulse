# ---- LinkPulse backend environment ----
# Server
PORT=3001
# Public base URL that serves short links (the redirect host).
BASE_URL=http://localhost:3001
# Comma-separated allowed frontend origins for CORS.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Security - CHANGE THESE IN PRODUCTION
JWT_SECRET=dev-change-me-please-use-a-long-random-string
IP_HASH_SALT=dev-change-me-ip-salt

# Database
# Leave DATABASE_URL empty/unset to use the built-in SQLite fallback (local dev).
# In production set a Postgres URL (Neon/Supabase), e.g.:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

# Cookie security (set true when serving over https)
COOKIE_SECURE=false
